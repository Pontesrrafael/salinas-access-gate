# =====================================================================
# Salinas Access Gate — configuração (copie para .env e ajuste)
# NUNCA versione o arquivo .env
# =====================================================================

# local | production
APP_ENV=local
APP_DEBUG=true
# URL pública (sem barra no final). Local: http://localhost:8080  |  Produção: https://accessgate.mycode.app.br
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Cuiaba
# Horário de Mato Grosso – UTC-4
DB_TIME_ZONE=-04:00

# Banco MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salinas_access_gate
DB_USERNAME=sag_app
DB_PASSWORD=troque_esta_senha
# Opcional (Linux): socket local, ex.: /run/mysqld/mysqld.sock
DB_SOCKET=

# Sessão
SESSION_NAME=sag_sessao
SESSION_IDLE_MINUTES=120
# true em produção (HTTPS)
SESSION_SECURE_COOKIE=false

# Criptografia do CPF (LGPD) — gere com: php bin/console.php gerar-chaves --gravar
# ATENÇÃO: guarde estas chaves em cofre. Sem elas os CPFs ficam irrecuperáveis.
CPF_ENCRYPTION_KEY=
CPF_INDEX_KEY=

# Segurança
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=8
# IPs de proxy reverso confiáveis (separados por vírgula), ex.: 127.0.0.1
TRUSTED_PROXIES=

# Uploads de fotos (fora da pasta pública)
UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=8
# UPLOAD_DIR=/home/accessgate/uploads

# Cloudflare Turnstile no formulário público (opcional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------
# Active Directory / LDAP (opcional). Com LDAP_ENABLED=false tudo é local.
# Contas locais (ex.: admin de contingência) continuam funcionando sempre.
# ---------------------------------------------------------------------
LDAP_ENABLED=false
# Um ou mais controladores de domínio (separados por espaço)
LDAP_HOST=ldaps://dc01.salinasgold.local
LDAP_PORT=0
# Use ldaps:// (636) ou LDAP_STARTTLS=true na 389. Texto puro é bloqueado.
LDAP_STARTTLS=false
LDAP_TLS_VERIFY=true
# Certificado da CA interna (formato PEM). Windows: C:/certs/ca-salinas.pem
LDAP_CA_CERT=
LDAP_TIMEOUT=5
LDAP_BASE_DN=DC=salinasgold,DC=local
# Opcional: restringe a busca de usuários a uma OU
LDAP_USERS_BASE_DN=
# Conta de serviço SOMENTE LEITURA (senha que não expira, sem logon interativo)
LDAP_BIND_DN=CN=svc-accessgate,OU=Servicos,DC=salinasgold,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_ATTR_LOGIN=sAMAccountName
LDAP_ATTR_GUID=objectGUID
LDAP_ATTR_NOME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_MATRICULA=employeeID
# Considera grupos aninhados (AD)
LDAP_NESTED_GROUPS=true
# Cria automaticamente no 1º login quem pertencer a um grupo mapeado abaixo
LDAP_AUTO_PROVISION=false
# Atualiza o perfil a cada login/sincronização conforme os grupos do AD
LDAP_SYNC_ROLES=false
# Grupos do AD → perfis (DN completo). Prioridade: admin > supervisor > ssma > porteiro
LDAP_GROUP_ADMIN=CN=GG-AccessGate-Admin,OU=Grupos,DC=salinasgold,DC=local
LDAP_GROUP_SUPERVISOR=CN=GG-AccessGate-Supervisor,OU=Grupos,DC=salinasgold,DC=local
LDAP_GROUP_SSMA=CN=GG-AccessGate-SSMA,OU=Grupos,DC=salinasgold,DC=local
LDAP_GROUP_PORTEIRO=CN=GG-AccessGate-Porteiro,OU=Grupos,DC=salinasgold,DC=local
LDAP_GROUP_SEG_PATRIMONIAL=CN=GG-AccessGate-SegPatrimonial,OU=Grupos,DC=salinasgold,DC=local
